/// Purchase orders pending at each month end (periodic snapshot).
table Fact_PO_Snapshot
	lineageTag: a6151df3-cdfe-4ab2-be69-3765f92505d0

	column 'Snapshot Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: dd3859a3-55c2-4f56-a63a-dee2828200f1
		summarizeBy: none
		sourceColumn: snapshot_date

		annotation UnderlyingDateTimeDataType = Date

	column 'PO ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 92e2869e-c151-429e-99ed-a3827e279f89
		summarizeBy: none
		sourceColumn: po_id

	column 'PO Number'
		dataType: string
		lineageTag: 69818844-9c1f-4d16-a5cc-24c67fcb3757
		summarizeBy: none
		sourceColumn: po_number

	column 'Supplier ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 66336275-a1ef-408b-b365-027ccf31bb5f
		summarizeBy: none
		sourceColumn: supplier_id

	column Urgency
		dataType: string
		lineageTag: 2e06f3e0-e2c7-4059-ac8c-c8e1296f7727
		summarizeBy: none
		sourceColumn: urgency

	partition Fact_PO_Snapshot = m
		mode: import
		queryGroup: Tables
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Fact_PO_Snapshot.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyAsNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(EmptyAsNull, {{"snapshot_date", type date}, {"po_id", Int64.Type}, {"po_number", type text}, {"supplier_id", Int64.Type}, {"urgency", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

