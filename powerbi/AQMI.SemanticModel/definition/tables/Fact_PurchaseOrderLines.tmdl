				    Typed = Table.TransformColumnTypes(EmptyAsNull, {{"po_line_id", Int64.Type}, {"po_number", type text}, {"supplier_id", Int64.Type}, {"material_id", Int64.Type}, {"order_date", type date}, {"urgency", type text}, {"promised_date", type date}, {"is_cancelled", Int64.Type}, {"qty_ordered", type number}, {"qty_received", type number}, {"qty_pending", type number}, {"line_value", type number}, {"first_receipt_date", type date}, {"last_receipt_date", type date}, {"line_status", type text}, {"is_received", Int64.Type}, {"days_late", Int64.Type}, {"is_on_time", Int64.Type}}, "en-US")
