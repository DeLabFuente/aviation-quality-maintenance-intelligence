	partition Dim_Material = m
		mode: import
		queryGroup: Tables
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Dim_Material.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyAsNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(EmptyAsNull, {{"material_id", Int64.Type}, {"part_number", type text}, {"description", type text}, {"material_label", type text}, {"material_class", type text}, {"unit_of_measure", type text}, {"preferred_supplier_code", type text}, {"standard_lead_time_days", Int64.Type}, {"min_stock_qty", type number}, {"reorder_qty", type number}, {"unit_cost", type number}, {"is_serialized", Int64.Type}, {"is_shelf_life_controlled", Int64.Type}, {"requires_release_certificate", Int64.Type}, {"is_active", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

