/// One row per stock movement.
table Fact_InventoryMovements
	lineageTag: 9015005c-b863-497a-bf22-348f113e4c51

	column 'Movement ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7930d141-5edb-4378-8553-e0f2b96f99d4
		summarizeBy: none
		sourceColumn: movement_id

	column 'Movement Number'
		dataType: string
		lineageTag: 2783e344-fe4a-46d4-8f54-069870ec3cae
		summarizeBy: none
		sourceColumn: movement_number

	column 'Movement Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 32d41597-7e7d-4243-a8e0-5d91cc0b0572
		summarizeBy: none
		sourceColumn: movement_date

		annotation UnderlyingDateTimeDataType = Date

	column 'Movement Datetime'
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy hh:nn
		lineageTag: 1c7f813f-5f1d-4779-b4b6-a2b69bc6cbf3
		summarizeBy: none
		sourceColumn: movement_datetime

	column 'Material ID'
