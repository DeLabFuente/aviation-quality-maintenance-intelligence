		sourceColumn: mo_number

	column 'Lot Number'
		dataType: string
		lineageTag: 08a0f6d4-a2c2-4f30-bcb3-0114f1a7492e
		summarizeBy: none
		sourceColumn: lot_number

	column 'Certificate Ref'
		dataType: string
		lineageTag: 2a76f063-da33-4b4d-acc4-a1d5178f2a83
		summarizeBy: none
		sourceColumn: certificate_ref

	column 'Is Traceable'
		dataType: int64
		formatString: #,0
		lineageTag: 60b32c06-e709-44d3-98e4-77851b0d23cc
		summarizeBy: none
		sourceColumn: is_traceable

	column 'Movement Value'
		dataType: double
		formatString: #,0.00
		lineageTag: d7929d37-32dc-46ce-98b7-3ad1afce942b
		summarizeBy: none
		sourceColumn: movement_value

	partition Fact_InventoryMovements = m
		mode: import
		queryGroup: Tables
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Fact_InventoryMovements.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyAsNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(EmptyAsNull, {{"movement_id", Int64.Type}, {"movement_number", type text}, {"movement_date", type date}, {"movement_datetime", type datetime}, {"material_id", Int64.Type}, {"movement_type", type text}, {"quantity", type number}, {"from_bucket", type text}, {"to_bucket", type text}, {"mo_number", type text}, {"lot_number", type text}, {"certificate_ref", type text}, {"is_traceable", Int64.Type}, {"movement_value", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

