		summarizeBy: none
		sourceColumn: material_id

	column 'Movement Type'
		dataType: string
		lineageTag: bb5a68ec-6364-4cd1-8561-14e27bb8a0e7
		summarizeBy: none
		sourceColumn: movement_type

	column Quantity
		dataType: double
		formatString: #,0.##
		lineageTag: e5e7c8fa-d5a6-4a25-a511-da4a06a9f40b
		summarizeBy: none
		sourceColumn: quantity

	column 'From Bucket'
		dataType: string
		lineageTag: f3d75d4c-391b-443a-93ec-46091d691815
		summarizeBy: none
		sourceColumn: from_bucket

	column 'To Bucket'
		dataType: string
		lineageTag: df76f3ca-3452-4e2e-8190-91151818f336
		summarizeBy: none
		sourceColumn: to_bucket

	column 'MO Number'
		dataType: string
		lineageTag: 67280b59-9456-4918-9036-3db28097e92a
