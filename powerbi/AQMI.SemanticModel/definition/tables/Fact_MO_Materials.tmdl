	partition Fact_MO_Materials = m
		mode: import
		queryGroup: Tables
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Fact_MO_Materials.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyAsNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(EmptyAsNull, {{"mo_material_id", Int64.Type}, {"mo_id", Int64.Type}, {"mo_number", type text}, {"aircraft_id", Int64.Type}, {"material_id", Int64.Type}, {"qty_required", type number}, {"required_by_date", type date}, {"first_reserved_date", type date}, {"last_issued_date", type date}, {"was_short", Int64.Type}, {"is_cancelled_order", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

