	partition Dim_KPI = m
		mode: import
		queryGroup: Tables
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Dim_KPI.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyAsNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(EmptyAsNull, {{"kpi_id", type text}, {"kpi_name", type text}, {"kpi_name_es", type text}, {"area", type text}, {"area_order", Int64.Type}, {"kpi_order", Int64.Type}, {"kpi_type", type text}, {"unit", type text}, {"direction", type text}, {"target", type number}, {"warning", type number}, {"target_label", type text}, {"sql_value", type number}, {"sql_numerator", type number}, {"sql_denominator", type number}, {"sql_status", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

