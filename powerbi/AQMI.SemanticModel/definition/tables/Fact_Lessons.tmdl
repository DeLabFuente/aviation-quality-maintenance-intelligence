				    Source = Csv.Document(File.Contents(DataFolder & "Fact_Lessons.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyAsNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(EmptyAsNull, {{"lesson_id", Int64.Type}, {"lesson_number", type text}, {"action_number", type text}, {"action_type", type text}, {"effectiveness_result", type text}, {"incident_number", type text}, {"title", type text}, {"recommendation", type text}, {"department_id", Int64.Type}, {"scope", type text}, {"status", type text}, {"status_order", Int64.Type}, {"proposed_date", type date}, {"approved_date", type date}, {"rejected_date", type date}, {"incorporated_date", type date}, {"incorporated_in", type text}, {"proposed_by_name", type text}, {"is_approved", Int64.Type}, {"is_incorporated", Int64.Type}, {"is_pending_incorporation", Int64.Type}, {"days_pending", Int64.Type}, {"days_to_decision", Int64.Type}, {"days_to_incorporate", Int64.Type}}, "en-US")
