	partition Dim_Aircraft = m
		mode: import
		queryGroup: Tables
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Dim_Aircraft.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyAsNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(EmptyAsNull, {{"aircraft_id", Int64.Type}, {"registration", type text}, {"fleet_number", type text}, {"aircraft_category", type text}, {"aircraft_model", type text}, {"customer_name", type text}, {"operation_type", type text}, {"contract_start_date", type date}, {"contract_end_date", type date}, {"operational_status", type text}, {"open_orders_now", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

