/// The fleet: aircraft, customer and operational status at the cut-off date.
table Dim_Aircraft
	lineageTag: 9ef9f49b-0563-4f29-9fc3-dd8d14ba5683

	column 'Aircraft ID'
		dataType: int64
		isHidden
		formatString: 0
