	partition Fact_AuditEvents = m
		mode: import
		queryGroup: Tables
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Fact_AuditEvents.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyAsNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(EmptyAsNull, {{"audit_id", Int64.Type}, {"event_datetime", type datetime}, {"event_date", type date}, {"table_name", type text}, {"record_id", Int64.Type}, {"record_ref", type text}, {"action", type text}, {"field_name", type text}, {"old_value", type text}, {"new_value", type text}, {"change_label", type text}, {"changed_by", Int64.Type}, {"source", type text}}, "en-US")
