/// Result of each of the 82 validation rules.
table Fact_ValidationResults
	lineageTag: 15671686-0a15-49af-a807-9b2cfa8dd7bf

	column 'Rule ID'
		dataType: string
		lineageTag: 8bcf3d08-b710-43f7-b1e7-c72321324af2
		summarizeBy: none
		sourceColumn: rule_id

	column 'Rule Group'
		dataType: string
		lineageTag: 68aa9145-98a9-45fa-a58d-ca1797600a79
		summarizeBy: none
		sourceColumn: rule_group

	column Title
		dataType: string
		lineageTag: 4384e701-26a8-488f-9c17-8e6150ab0993
		summarizeBy: none
		sourceColumn: title

	column Severity
		dataType: string
		lineageTag: 063d3e17-6fa2-4b16-bb02-50bde714ba1f
		summarizeBy: none
		sourceColumn: severity

	column Result
		dataType: string
		lineageTag: 2ffd1976-f12e-4daf-a4c6-de2dc38ce5f2
		summarizeBy: none
		sourceColumn: result

	column Findings
		dataType: int64
		formatString: #,0
		lineageTag: 1b73edff-5b31-4182-8338-bbd550aad1df
		summarizeBy: none
		sourceColumn: findings

	partition Fact_ValidationResults = m
		mode: import
		queryGroup: Tables
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Fact_ValidationResults.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyAsNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(EmptyAsNull, {{"rule_id", type text}, {"rule_group", type text}, {"title", type text}, {"severity", type text}, {"result", type text}, {"findings", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

